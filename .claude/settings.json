{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "coordinador",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git blame:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format --verify-no-changes:*)"
    ],
    "ask": [
      "Bash(dotnet run:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef database update:*)",
      "Edit(**/ISA.md)",
      "Edit(**/PLAN.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/adr/**)",
      "Edit(/docs/LECCIONES.md)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git apply:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(dotnet ef database drop:*)",

      "Edit(/.claude/**)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/secrets/**)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/appsettings.Production.json)",
      "Read(**/appsettings.Staging.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.microsoft/usersecrets/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)"
    ]
  }
}
