{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "coordinador",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git blame:*)",
      "Bash(git show:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format --verify-no-changes:*)"
    ],
    "ask": [
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet run:*)",

      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(**/ISA.md)",
      "Write(**/ISA.md)",
      "Edit(**/PLAN.md)",
      "Write(**/PLAN.md)",
      "Edit(docs/adr/**)",
      "Write(docs/adr/**)",
      "Edit(docs/LECCIONES.md)",
      "Write(docs/LECCIONES.md)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(dotnet ef database drop:*)",

      "Edit(.claude/**)",
      "Write(.claude/**)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/.aws/credentials)",
      "Read(**/.microsoft/usersecrets/**)",
      "Read(**/Microsoft/UserSecrets/**)",
      "Read(**/appsettings.Production.json)",
      "Read(**/appsettings.Staging.json)",
      "Read(**/appsettings.Local.json)"
    ]
  }
}
