{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "coordinador",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git blame:*)",
      "Bash(git show:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet format --verify-no-changes:*)"
    ],
    "ask": [
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef database update:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",

      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(**/PLAN.md)",
      "Edit(**/ISA.md)",
      "Write(**/PLAN.md)",
      "Write(**/ISA.md)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/.aws/credentials)",
      "Read(**/appsettings.Production.json)",
      "Read(**/appsettings.*.json)"
    ]
  }
}
